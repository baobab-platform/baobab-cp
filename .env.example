HTTP_ADDRESS=:8080
# Matches docker-compose.yml's default (`make dev-up`). Pointing this at
# baobab-platform/infrastructure's own topology instead (`make dev-up-infra`)?
# Run `make dev-env-infra` for the exact DATABASE_URL/RABBITMQ_URL to use -
# same db/user name, but that repo's compose/.env sets its own password.
DATABASE_URL=postgres://baobab_control:baobab_control@localhost:5432/baobab_control?sslmode=disable
ADMIN_OIDC_ISSUER=https://identity.example.com
ADMIN_OIDC_AUDIENCE=baobab-control-plane
# IAM workforce client whose resource_access roles back scope entitlements (onboarding-requester, ...).
ADMIN_OIDC_CLIENT_ID=baobab-control-plane-admin
WORKLOAD_OIDC_ISSUER=https://identity.example.com
WORKLOAD_OIDC_AUDIENCE=baobab-control-plane
