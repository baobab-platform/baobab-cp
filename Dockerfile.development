# Explicit disposable-development tooling. Production Dockerfile stays separate.
FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/controlplane ./cmd/controlplane && \
    CGO_ENABLED=0 go build -trimpath -o /out/development-bootstrap ./cmd/development-bootstrap
FROM gcr.io/distroless/static-debian13:nonroot@sha256:aafe993665bf6200db38a02c11a9351e782a84b6a45e7f33b6695638c88e3931
COPY --from=build /out/controlplane /controlplane
COPY --from=build /out/development-bootstrap /development-bootstrap
USER nonroot:nonroot
ENTRYPOINT ["/controlplane"]
