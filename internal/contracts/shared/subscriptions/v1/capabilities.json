          "request_schema": "billing.schema.json#/$defs/EnsureBillingProjectionRequest",
          "response_schema": "billing.schema.json#/$defs/BillingProjection",
          "error_schema": "../../errors/v1/problem-details.schema.json",
          "event_schemas": [
            "events.schema.json#/$defs/BillingSubscriptionCreated",
            "events.schema.json#/$defs/BillingSubscriptionSuspended",
