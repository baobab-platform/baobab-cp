{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/capability/v1/registration.schema.json",
  "title": "Engine Capability Registration (ADR-SHARED-011)",
  "description": "TRANSITIONAL registration bundle (ADR-SHARED-017 SS32). Definition library for an engine's published capability registration: the capabilities it implements and the provider it registers, without the identifiers the Control Plane mints on registration (capability_id, provider_id). The Control Plane registers these through its normal capability registry, provider and binding mechanisms; nothing is special-cased by engine name. An EngineRegistration is no longer an authoring format: its capabilities must equal the canonical definitions indexed by catalogue.yaml, and scripts/capability_catalogue.py generates it from those definitions plus an engine's provider declaration (provider-declaration.schema.json). Which bundles exist is stated by registration-bundles.yaml (#/$defs/RegistrationBundleIndex), never by a file name. Validate against #/$defs/EngineRegistration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "RegistrationBundleIndex": {
      "type": "object",
      "additionalProperties": false,
      "description": "TRANSITIONAL. The explicit list of EngineRegistration bundles the Control Plane bootstraps from while it still registers providers from Shared (ADR-SHARED-017 SS30, SS32). It replaces discovery by the /capabilities.json file-name suffix; it is removed once providers register through governed provider registration instead.",
      "required": ["schema", "bundles"],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "baobab-engine-registration-bundle-index" },
            "version": { "const": "1.0" }
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "engine_id", "provider_key"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9.-]*)*\\.(?:json|yaml)$",
                "maxLength": 255,
                "description": "Path of the EngineRegistration under contracts/, e.g. payments/v1/capabilities.json."
              },
              "engine_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineId" },
              "provider_key": { "$ref": "domain.schema.json#/$defs/capabilityProviderKey" }
            }
          }
        }
      }
    },
    "EngineRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "capabilities",
        "provider",
        "support"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 63,
          "description": "The owning repository, e.g. baobab-subscriptions."
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_key",
              "name",
              "domain",
              "owner",
              "lifecycle",
              "maturity",
              "contracts"
            ],
            "properties": {
              "capability_key": {
                "$ref": "domain.schema.json#/$defs/capabilityKey"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "domain": {
                "$ref": "domain.schema.json#/$defs/capabilityDomain"
              },
              "owner": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 63
              },
              "lifecycle": {
                "$ref": "domain.schema.json#/$defs/capabilityLifecycle"
              },
              "maturity": {
                "$ref": "domain.schema.json#/$defs/capabilityMaturity"
              },
              "contracts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "capability.schema.json#/$defs/capabilityContractVersion"
                }
              },
              "data_classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "TENANT_CONFIDENTIAL",
                  "RESTRICTED"
                ]
              }
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_key",
            "name",
            "provider_type",
            "engine_key",
            "lifecycle",
            "ownership",
            "simulated"
          ],
          "properties": {
            "provider_key": {
              "$ref": "domain.schema.json#/$defs/capabilityProviderKey"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "provider_type": {
              "$ref": "domain.schema.json#/$defs/capabilityProviderType"
            },
            "engine_key": {
              "$ref": "domain.schema.json#/$defs/engineKey"
            },
            "lifecycle": {
              "const": "DRAFT",
              "description": "Registration never activates a provider (EA-02C): a registered provider is DRAFT. Re-registering an existing provider never changes its lifecycle. A provider becomes ACTIVE only through a PROVIDER_ACTIVATION changeset (control-plane/v1 changeset-lifecycle.yaml), whose plan checks its declaration, support, contract compatibility, release, instances and health."
            },
            "ownership": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 63
            },
            "simulated": {
              "type": "boolean",
              "description": "True when the provider only simulates the capability (development/integration only). A simulated provider must never be bound for production traffic."
            },
            "production_permitted": {
              "type": "boolean",
              "default": false
            },
            "invocation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "service_reference",
                "protocol"
              ],
              "description": "How callers invoke this provider: the source of a RESOLVED CapabilityResolution's invocation descriptor (resolution.schema.json invocationDescriptor). A logical reference only, never a deployment hostname or credential; the Control Plane pairs it with the resolved binding's engine instance.",
              "properties": {
                "service_reference": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^service://[a-z][a-z0-9-]*(?:/[a-z0-9-]+)*$",
                  "maxLength": 255,
                  "description": "Logical service reference, e.g. service://baobab-trade/orders."
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "http",
                    "grpc"
                  ]
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "simulated": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "production_permitted": {
                    "const": false
                  }
                }
              }
            }
          ]
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_key",
              "contract_versions"
            ],
            "properties": {
              "capability_key": {
                "$ref": "domain.schema.json#/$defs/capabilityKey"
              },
              "contract_versions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
