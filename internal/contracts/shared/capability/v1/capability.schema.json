{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/capability/v1/capability.schema.json",
  "title": "CapabilityDefinition and CapabilityDependency",
  "description": "A Capability describes WHAT the platform can do, never HOW or WHERE. It carries no provider, engine, tenant or region identity.",
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_key", "name", "domain", "lifecycle", "maturity", "contracts", "version"],
      "properties": {
        "capability_id": { "$ref": "domain.schema.json#/$defs/capabilityId" },
        "capability_key": { "$ref": "domain.schema.json#/$defs/capabilityKey" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "domain": { "$ref": "domain.schema.json#/$defs/capabilityDomain" },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 63,
          "description": "Repository that owns this capability's semantics, evolution and conformance, e.g. \"baobab-trade\". baobab-platform/shared remains contract authority regardless of ownership."
        },
        "lifecycle": { "$ref": "domain.schema.json#/$defs/capabilityLifecycle" },
        "maturity": { "$ref": "domain.schema.json#/$defs/capabilityMaturity" },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityContractVersion" },
          "description": "Every compatible request/response/error/event contract major version this capability currently supports."
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityDependency" },
          "default": []
        },
        "health_criticality": {
          "$ref": "domain.schema.json#/$defs/capabilityHealthCriticality",
          "default": "STANDARD",
          "description": "Which provider health this capability tolerates (ADR-BCP-006 SS22, health-policy.yaml). Absent means STANDARD."
        },
        "data_classification": {
          "type": "string",
          "enum": ["PUBLIC", "INTERNAL", "TENANT_CONFIDENTIAL", "RESTRICTED"],
          "description": "Baseline sensitivity of data this capability's contract carries."
        },
        "metadata": { "type": "object" },
        "version": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "canonicalCapabilityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "description": "A capability as Shared authors it, before the Control Plane registers it: the #/$defs/capability fields without the identifiers and revision the Control Plane mints (capability_id, version, created_at, updated_at). Authored only in a CapabilityDefinitionDocument indexed by catalogue.yaml (ADR-SHARED-017 SS18-20). Carries no provider, engine, tenant, region, binding or health.",
      "required": ["capability_key", "name", "domain", "owner", "lifecycle", "maturity", "contracts"],
      "properties": {
        "capability_key": { "$ref": "domain.schema.json#/$defs/capabilityKey" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "domain": { "$ref": "domain.schema.json#/$defs/capabilityDomain" },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 63,
          "description": "Repository stewarding this capability's semantics. Semantic ownership is not a provider monopoly: other providers may implement it (ADR-SHARED-017 SS15)."
        },
        "lifecycle": { "$ref": "domain.schema.json#/$defs/capabilityLifecycle" },
        "maturity": { "$ref": "domain.schema.json#/$defs/capabilityMaturity" },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityContractVersion" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityDependency" }
        },
        "health_criticality": { "$ref": "domain.schema.json#/$defs/capabilityHealthCriticality" },
        "data_classification": {
          "type": "string",
          "enum": ["PUBLIC", "INTERNAL", "TENANT_CONFIDENTIAL", "RESTRICTED"]
        },
        "metadata": { "type": "object" }
      }
    },
    "CapabilityDefinitionDocument": {
      "type": "object",
      "additionalProperties": false,
      "description": "A file of canonical capability definitions, e.g. contracts/payments/v1/capabilities.yaml. Membership of the canonical catalogue comes from catalogue.yaml naming a definition and this document, never from the file's name or serialization (ADR-SHARED-017 SS30, SS54). Contract schema references resolve relative to the document.",
      "required": ["schema", "capabilities"],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "baobab-capability-definitions" },
            "version": { "const": "1.0" }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/canonicalCapabilityDefinition" }
        }
      }
    },
    "capabilityContractVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "request_schema", "response_schema"],
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "request_schema": { "type": "string", "format": "uri-reference" },
        "response_schema": { "type": "string", "format": "uri-reference" },
        "error_schema": { "type": "string", "format": "uri-reference" },
        "event_schemas": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" },
          "default": []
        }
      }
    },
    "capabilityDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_key", "dependency_type"],
      "properties": {
        "capability_key": { "$ref": "domain.schema.json#/$defs/capabilityKey" },
        "dependency_type": { "$ref": "domain.schema.json#/$defs/capabilityDependencyType" },
        "version_constraint": {
          "type": "string",
          "pattern": "^>=\\d+(\\.\\d+)?(\\.\\d+)? <\\d+(\\.\\d+)?(\\.\\d+)?$",
          "description": "Semantic version range the dependent capability requires, e.g. \">=1.0 <2.0\"."
        },
        "condition": {
          "type": "string",
          "maxLength": 500,
          "description": "Machine-evaluable condition for a CONDITIONAL dependency (canonical vocabulary defined per capability domain). A CONDITIONAL dependency must always carry this field; it is never expressed only in prose."
        }
      },
      "if": { "properties": { "dependency_type": { "const": "CONDITIONAL" } } },
      "then": { "required": ["capability_key", "dependency_type", "condition"] }
    }
  }
}
