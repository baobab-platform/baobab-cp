{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/capability/v1/certification.schema.json",
  "title": "Provider Capability Certification (EA-09)",
  "description": "EA-09 certification is a Control Plane-owned qualification record for one provider, one canonical capability contract major and one immutable EngineRelease. Certification is distinct from repository IMPLEMENTED status, release approval, provider lifecycle, health, bindings and grants. Validate concrete resources against the named $defs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "certificationId": {
      "type": "string",
      "pattern": "^cert_[0-9a-f]{32}$"
    },
    "certificationStatus": {
      "type": "string",
      "enum": ["CERTIFIED", "REVOKED"]
    },
    "qualificationProfile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{2,127}$",
      "maxLength": 128
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "CONFORMANCE_REPORT",
        "CONTRACT_TEST",
        "INTEGRATION_TEST",
        "SECURITY_REVIEW",
        "PERFORMANCE_REPORT",
        "OPERABILITY_REVIEW",
        "OTHER"
      ]
    },
    "CertificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "digest"],
      "properties": {
        "type": { "$ref": "#/$defs/evidenceType" },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^(?:https|oci)://",
          "maxLength": 512
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "ProviderCapabilityCertificationRecordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "capability_key",
        "contract_version",
        "release_id",
        "qualification_profile",
        "evidence",
        "reason"
      ],
      "properties": {
        "provider_id": { "$ref": "domain.schema.json#/$defs/capabilityProviderId" },
        "capability_key": { "$ref": "domain.schema.json#/$defs/capabilityKey" },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "release_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" },
        "qualification_profile": { "$ref": "#/$defs/qualificationProfile" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/CertificationEvidence" }
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "ProviderCapabilityCertification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_id",
        "provider_id",
        "provider_key",
        "capability_key",
        "contract_version",
        "release_id",
        "qualification_profile",
        "evidence",
        "status",
        "certified_by",
        "certified_at",
        "reason"
      ],
      "properties": {
        "certification_id": { "$ref": "#/$defs/certificationId" },
        "provider_id": { "$ref": "domain.schema.json#/$defs/capabilityProviderId" },
        "provider_key": { "$ref": "domain.schema.json#/$defs/capabilityProviderKey" },
        "capability_key": { "$ref": "domain.schema.json#/$defs/capabilityKey" },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "release_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" },
        "qualification_profile": { "$ref": "#/$defs/qualificationProfile" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/CertificationEvidence" }
        },
        "status": { "$ref": "#/$defs/certificationStatus" },
        "certified_by": { "$ref": "../../administration/v1/domain.schema.json#/$defs/principalId" },
        "certified_at": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "revoked_by": { "$ref": "../../administration/v1/domain.schema.json#/$defs/principalId" },
        "revoked_at": { "type": "string", "format": "date-time" },
        "revocation_reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "REVOKED" } },
            "required": ["status"]
          },
          "then": {
            "required": ["revoked_by", "revoked_at", "revocation_reason"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["revoked_by"] },
                { "required": ["revoked_at"] },
                { "required": ["revocation_reason"] }
              ]
            }
          }
        }
      ]
    },
    "ProviderCapabilityCertificationRevocationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "ProviderCapabilityCertificationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/ProviderCapabilityCertification" }
        },
        "next_cursor": {
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    }
  }
}
