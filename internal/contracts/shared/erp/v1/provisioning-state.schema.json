{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/erp/v1/provisioning-state.schema.json",
  "title": "ERP provisioning state",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "tenant_id", "legal_entity_ids", "state", "revision", "updated_at"],
  "properties": {
    "operation_id": { "$ref": "./domain.schema.json#/$defs/operationId" },
    "tenant_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId" },
    "legal_entity_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/legalEntityId" }
    },
    "state": { "type": "string", "enum": ["accepted", "validating", "provisioning", "reconciling", "active", "failed", "cancelled"] },
    "revision": { "$ref": "./domain.schema.json#/$defs/version" },
    "updated_at": { "$ref": "./domain.schema.json#/$defs/timestamp" },
    "failure_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 96 }
  }
}
