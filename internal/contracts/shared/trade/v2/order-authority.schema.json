{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/trade/v2/order-authority.schema.json",
  "title": "Trade order authority resolution (P0-04B Trade-0, ADR-SHARED-039)",
  "description": "Joins Control Plane seller-operating and legal-actor authority to one consequential Trade operation. CP owns the tenant, operating Organisation, market, verified legal entity, mandate, role, activity, engine-instance binding and the Seller Operating Binding lifecycle; Trade owns native commerce execution and attribution. The request can only name a workload-owned RUNTIME context, the Trade engine instance, a catalogued operation class, a CP Seller Operating Binding reference, Trade's current native-configuration digest and an opaque operation reference: it cannot select a tenant, Organisation, legal entity, mandate, role, activity, market or decision time, and carries no native Medusa identifier. AUTHORIZED is a short-lived fact for exactly one operation reference and binding version, never a provider permission, money-movement authority, ERP posting authority or cached grant.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "operationClass": {
      "type": "string",
      "enum": [
        "trade.order.commit",
        "trade.order.create",
        "trade.draft-order.finalize",
        "trade.order.edit",
        "trade.order.cancel",
        "trade.return.accept",
        "trade.exchange.accept",
        "trade.claim.accept",
        "trade.payment-authorization.request",
        "trade.payment-capture.request",
        "trade.payment-void.request",
        "trade.payment-refund.request",
        "trade.fulfilment.create",
        "trade.shipment.create"
      ],
      "description": "Closed vocabulary; order-operations.yaml maps each class to exactly one legal-actor role and activity. Extensions and activations require a versioned catalogue revision."
    },
    "operationReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\x21-\\x7E]+$",
      "description": "Exact Trade operation and transaction the decision is bound to (for example trade/<class>/<subject>/<revision>/<attempt>). A decision for one reference is never valid for another."
    },
    "OrderAuthorityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "engine_instance_id",
        "operation_class",
        "seller_operating_binding_reference",
        "native_configuration_digest",
        "currency",
        "operation_reference"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "format": "uuid"
        },
        "engine_instance_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineInstanceId"
        },
        "operation_class": {
          "$ref": "#/$defs/operationClass"
        },
        "seller_operating_binding_reference": {
          "$ref": "seller-operating-binding.schema.json#/$defs/bindingReference"
        },
        "native_configuration_digest": {
          "$ref": "seller-operating-binding.schema.json#/$defs/configurationDigest"
        },
        "operation_reference": {
          "$ref": "#/$defs/operationReference"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      }
    },
    "OrderAuthorityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "context_id",
        "engine_instance_id",
        "operation_class",
        "seller_operating_binding_reference",
        "native_configuration_digest",
        "currency",
        "operation_reference",
        "outcome",
        "evaluated_at",
        "policy_reference",
        "provider_permissions_granted"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "format": "uuid",
          "description": "Identifier of the immutable decision record CP retains, so an order can later answer which seller and legal actor applied at its time."
        },
        "context_id": {
          "type": "string",
          "format": "uuid"
        },
        "engine_instance_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineInstanceId"
        },
        "operation_class": {
          "$ref": "#/$defs/operationClass"
        },
        "seller_operating_binding_reference": {
          "$ref": "seller-operating-binding.schema.json#/$defs/bindingReference"
        },
        "native_configuration_digest": {
          "$ref": "seller-operating-binding.schema.json#/$defs/configurationDigest"
        },
        "operation_reference": {
          "$ref": "#/$defs/operationReference"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "AUTHORIZED",
            "NO_APPLICABLE_MANDATE",
            "AMBIGUOUS",
            "REVOKED_OR_EXPIRED",
            "ACTOR_NOT_VERIFIED",
            "ENGINE_INSTANCE_NOT_BOUND",
            "CONTEXT_NOT_USABLE",
            "BINDING_NOT_ACTIVE",
            "BINDING_SCOPE_MISMATCH",
            "NATIVE_CONFIGURATION_MISMATCH",
            "OPERATION_NOT_ACTIVATED"
          ]
        },
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "operating_organisation_id": {
          "$ref": "../../organisation/v2/domain.schema.json#/$defs/organisationId"
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "legal_actor_role": {
          "$ref": "../../organisation/v2/legal-actor-mandate.schema.json#/$defs/legalActorRole"
        },
        "activity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "mandate_id": {
          "type": "string",
          "format": "uuid"
        },
        "supersedes_mandate_id": {
          "type": "string",
          "format": "uuid"
        },
        "responsible_legal_entity_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalLegalEntityId"
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "mandate_effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "mandate_effective_to": {
          "type": "string",
          "format": "date-time"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "At most 30 seconds after evaluated_at and never after the RUNTIME context, the binding's effective end or the mandate end (semantic rule). Trade must deny at its execution point once min(expires_at, local receipt + 30 s) has passed."
        },
        "policy_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "provider_permissions_granted": {
          "const": false
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "AUTHORIZED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "tenant_id",
              "operating_organisation_id",
              "market",
              "legal_actor_role",
              "activity",
              "mandate_id",
              "responsible_legal_entity_id",
              "evidence_references",
              "mandate_effective_from",
              "expires_at"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "mandate_id"
                  ]
                },
                {
                  "required": [
                    "supersedes_mandate_id"
                  ]
                },
                {
                  "required": [
                    "responsible_legal_entity_id"
                  ]
                },
                {
                  "required": [
                    "evidence_references"
                  ]
                },
                {
                  "required": [
                    "mandate_effective_from"
                  ]
                },
                {
                  "required": [
                    "mandate_effective_to"
                  ]
                },
                {
                  "required": [
                    "expires_at"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "enum": [
                  "trade.order.edit",
                  "trade.order.cancel",
                  "trade.return.accept",
                  "trade.exchange.accept",
                  "trade.claim.accept",
                  "trade.payment-authorization.request",
                  "trade.payment-capture.request",
                  "trade.payment-void.request",
                  "trade.payment-refund.request",
                  "trade.fulfilment.create",
                  "trade.shipment.create"
                ]
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "OPERATION_NOT_ACTIVATED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "OPERATION_NOT_ACTIVATED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "operation_class": {
                "enum": [
                  "trade.order.edit",
                  "trade.order.cancel",
                  "trade.return.accept",
                  "trade.exchange.accept",
                  "trade.claim.accept",
                  "trade.payment-authorization.request",
                  "trade.payment-capture.request",
                  "trade.payment-void.request",
                  "trade.payment-refund.request",
                  "trade.fulfilment.create",
                  "trade.shipment.create"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.order.commit"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "CHECKOUT_ORDER_COMMITMENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.order.create"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "DIRECT_ORDER_COMMITMENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.draft-order.finalize"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "DRAFT_ORDER_FINALISATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.order.edit"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "ORDER_AMENDMENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.order.cancel"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "ORDER_CANCELLATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.return.accept"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "RETURN_ACCEPTANCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.exchange.accept"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "EXCHANGE_ACCEPTANCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.claim.accept"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "CLAIM_ACCEPTANCE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.payment-authorization.request"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "PAYMENT_AUTHORIZATION_INSTRUCTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.payment-capture.request"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "PAYMENT_CAPTURE_INSTRUCTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.payment-void.request"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "PAYMENT_VOID_INSTRUCTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.payment-refund.request"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "PAYMENT_REFUND_INSTRUCTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.fulfilment.create"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "FULFILMENT_INSTRUCTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_class": {
                "const": "trade.shipment.create"
              }
            },
            "required": [
              "operation_class"
            ]
          },
          "then": {
            "properties": {
              "legal_actor_role": {
                "const": "SELLER_OF_RECORD"
              },
              "activity": {
                "const": "SHIPMENT_INSTRUCTION"
              }
            }
          }
        }
      ],
      "description": "Semantic rules consumers must also apply: evaluated_at < expires_at <= evaluated_at + 30 seconds; the decision echoes the request exactly; a reserved (non-activatable) class only ever answers OPERATION_NOT_ACTIVATED, and only a reserved class may; the currency is in the binding's currency_scope."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency of this operation, from Trade's server-verified cart, draft or order. CP requires it to be in the binding's currency_scope (otherwise BINDING_SCOPE_MISMATCH) and echoes it; Trade must deny when the committed record's currency differs."
    }
  }
}
