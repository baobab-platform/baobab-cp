{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/topology/v1/events.schema.json",
  "title": "Baobab Engine Release Event Payloads (ADR-BCP-025)",
  "description": "Definition library for the data payloads of the ADR-BCP-025 section 2.10 events, published by baobab-platform/baobab-cp from its transactional outbox in the same transaction as the change, inside the canonical envelope (contracts/events/v1). Composition with the envelope happens in asyncapi.yaml. Every event is platform-scoped (baobabscope platform): a release belongs to an engine, not a tenant.\n\nPayloads carry identifiers, versions, digests and states: never the audit reason text, a principal, a tenant or a credential. Consumers read the rest through the Control Plane.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "EngineReleaseRecorded": {
      "type": "object",
      "additionalProperties": false,
      "description": "A new release was recorded as CANDIDATE. A byte-identical replay records nothing and publishes nothing.",
      "required": ["release_id", "engine_id", "release_version", "source_revision", "status", "recorded_at"],
      "properties": {
        "release_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" },
        "engine_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineId" },
        "release_version": { "$ref": "domain.schema.json#/$defs/releaseVersion" },
        "source_revision": { "$ref": "domain.schema.json#/$defs/sourceRevision" },
        "status": { "const": "CANDIDATE" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "EngineReleaseStatusChanged": {
      "type": "object",
      "additionalProperties": false,
      "description": "A release moved along release-policy.yaml status_transitions. A revocation is published together with the desired-release-changed events of every instance it moved.",
      "required": ["release_id", "engine_id", "release_version", "previous_status", "status", "changed_at"],
      "properties": {
        "release_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" },
        "engine_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineId" },
        "release_version": { "$ref": "domain.schema.json#/$defs/releaseVersion" },
        "previous_status": { "$ref": "domain.schema.json#/$defs/releaseStatus" },
        "status": { "$ref": "domain.schema.json#/$defs/releaseStatus" },
        "changed_at": { "type": "string", "format": "date-time" }
      }
    },
    "EngineInstanceDesiredReleaseChanged": {
      "type": "object",
      "additionalProperties": false,
      "description": "An engine instance's desired release changed (section 2.5). Infrastructure tooling may consume this instead of polling: when a release is desired, the payload carries its artifacts, which is everything needed to execute the change. desired_release_id is null when the desired release was cleared.",
      "required": ["engine_instance_id", "engine_id", "previous_release_id", "desired_release_id", "version", "changed_at"],
      "properties": {
        "engine_instance_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineInstanceId" },
        "engine_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineId" },
        "previous_release_id": {
          "anyOf": [{ "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" }, { "type": "null" }]
        },
        "desired_release_id": {
          "anyOf": [{ "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" }, { "type": "null" }]
        },
        "desired_release_version": { "$ref": "domain.schema.json#/$defs/releaseVersion" },
        "desired_artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "release.schema.json#/$defs/Artifact" }
        },
        "changeset_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/changesetId" },
        "version": { "type": "integer", "minimum": 1 },
        "changed_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "desired_release_id": { "type": "string" } }, "required": ["desired_release_id"] },
          "then": { "required": ["desired_release_version", "desired_artifacts"] },
          "else": { "not": { "anyOf": [{ "required": ["desired_release_version"] }, { "required": ["desired_artifacts"] }] } }
        }
      ]
    },
    "EngineInstanceReleaseDriftDetected": {
      "type": "object",
      "additionalProperties": false,
      "description": "An engine instance started to drift from its desired release (section 2.7). Published once when the drift opens or its reason changes, not on every sweep that still sees it.",
      "required": ["engine_instance_id", "engine_id", "drift_reason", "desired_release_id", "observed_state", "detected_at"],
      "properties": {
        "engine_instance_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineInstanceId" },
        "engine_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineId" },
        "drift_reason": { "$ref": "domain.schema.json#/$defs/releaseDriftReason" },
        "desired_release_id": {
          "anyOf": [{ "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" }, { "type": "null" }]
        },
        "observed_state": { "$ref": "domain.schema.json#/$defs/observedReleaseState" },
        "observed_release_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/engineReleaseId" },
        "observation_id": { "$ref": "../../control-plane/v1/domain.schema.json#/$defs/deploymentObservationId" },
        "detected_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "observed_state": { "const": "RELEASE" } }, "required": ["observed_state"] },
          "then": { "required": ["observed_release_id"] },
          "else": { "not": { "required": ["observed_release_id"] } }
        },
        {
          "if": { "properties": { "drift_reason": { "const": "RELEASE_UNOBSERVED" } }, "required": ["drift_reason"] },
          "then": { "properties": { "observed_state": { "const": "UNKNOWN" } } }
        },
        {
          "if": { "properties": { "drift_reason": { "const": "REVOKED_RELEASE_RUNNING" } }, "required": ["drift_reason"] },
          "then": { "properties": { "observed_state": { "const": "RELEASE" } } }
        },
        {
          "if": { "properties": { "drift_reason": { "const": "UNKNOWN_ARTIFACT_RUNNING" } }, "required": ["drift_reason"] },
          "then": { "properties": { "observed_state": { "enum": ["UNKNOWN_ARTIFACT", "FOREIGN_ARTIFACT"] } } }
        }
      ]
    }
  }
}
