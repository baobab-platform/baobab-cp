{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/control-plane/v1/context-resolution.schema.json",
  "title": "Resolve authenticated tenant context",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id"],
      "properties": {
        "product_id": { "$ref": "domain.schema.json#/$defs/productId" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "entity_id", "lifecycle_status", "product_id", "entitled", "cache_ttl_seconds", "resolved_at", "correlation_id"],
      "properties": {
        "tenant_id": { "$ref": "domain.schema.json#/$defs/tenantId" },
        "entity_id": { "$ref": "domain.schema.json#/$defs/legalEntityId" },
        "lifecycle_status": { "type": "string", "enum": ["provisioning", "active", "suspended", "decommissioning", "decommissioned"] },
        "product_id": { "$ref": "domain.schema.json#/$defs/productId" },
        "entitled": { "const": true },
        "entitlement_tier": { "type": ["string", "null"], "maxLength": 63 },
        "cache_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "resolved_at": { "type": "string", "format": "date-time" },
        "correlation_id": { "$ref": "domain.schema.json#/$defs/uuid" }
      }
    }
  }
}
