{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/control-plane/v1/console-dataset.schema.json",
  "title": "Governed dataset operations",
  "$defs": {
    "MetadataChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organisation_id",
        "expected_version",
        "internal_label"
      ],
      "properties": {
        "organisation_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "internal_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "PreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "REDACTED_CSV_EXPORT",
            "BULK_METADATA_PROPOSAL"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/MetadataChange"
          }
        }
      }
    },
    "PreviewResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "source_fingerprint",
        "rows"
      ],
      "properties": {
        "kind": {
          "enum": [
            "REDACTED_CSV_EXPORT",
            "BULK_METADATA_PROPOSAL"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/MetadataChange"
          }
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "change_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "organisation_id",
              "display_name",
              "status",
              "verification_state",
              "source_authority",
              "revision"
            ],
            "properties": {
              "organisation_id": {
                "type": "string",
                "format": "uuid"
              },
              "display_name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "verification_state": {
                "type": "string"
              },
              "source_authority": {
                "type": "string"
              },
              "jurisdiction": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "ProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_ids",
        "source_fingerprint",
        "purpose",
        "recipient_reference",
        "valid_until"
      ],
      "properties": {
        "kind": {
          "enum": [
            "REDACTED_CSV_EXPORT",
            "BULK_METADATA_PROPOSAL"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/MetadataChange"
          }
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "change_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "recipient_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_reference"
      ],
      "properties": {
        "evidence_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "kind",
        "state"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "REDACTED_CSV_EXPORT",
            "BULK_METADATA_PROPOSAL"
          ]
        },
        "state": {
          "enum": [
            "PENDING_APPROVAL",
            "APPROVED",
            "COMPLETED"
          ]
        }
      }
    },
    "ReviewReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "kind",
        "state",
        "purpose",
        "recipient_reference",
        "target_ids",
        "source_fingerprint",
        "change_fingerprint",
        "valid_until",
        "changes"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "REDACTED_CSV_EXPORT",
            "BULK_METADATA_PROPOSAL"
          ]
        },
        "state": {
          "enum": [
            "PENDING_APPROVAL",
            "APPROVED",
            "COMPLETED"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "recipient_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "source_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "change_fingerprint": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})?$"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "changes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/MetadataChange"
          }
        }
      }
    }
  }
}
