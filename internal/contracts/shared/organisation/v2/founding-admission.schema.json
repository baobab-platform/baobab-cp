{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v2/founding-admission.schema.json",
  "title": "Founding Group Sponsorship and Documentary Deferral (ADR-BCP-026)",
  "description": "First-party sponsorship proves a governed admission basis only, never incorporation, ownership, legal-actor mandate, IAM access or automatic INTERNAL subscription eligibility.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "FoundingGroupSponsorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sponsor_organisation_id",
        "operating_organisation_id",
        "platform_id",
        "status",
        "scope",
        "authority_basis_reference",
        "approved_by",
        "approved_at",
        "effective_from",
        "effective_to",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sponsor_organisation_id": {
          "$ref": "domain.schema.json#/$defs/organisationId"
        },
        "operating_organisation_id": {
          "$ref": "domain.schema.json#/$defs/organisationId"
        },
        "platform_id": {
          "$ref": "../v1/domain.schema.json#/$defs/platformId"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "scope": {
          "const": "INTERNAL_GROUP_ADMISSION"
        },
        "authority_basis_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Governed first-party admission relationship; does NOT assert a verified OWNS edge or enable entitlement."
    },
    "FoundingDocumentaryDeferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organisation_id",
        "sponsorship_id",
        "requirement_ids",
        "policy_reference",
        "approved_by",
        "approved_at",
        "effective_from",
        "expires_at",
        "maximum_duration_months",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "organisation_id": {
          "$ref": "domain.schema.json#/$defs/organisationId"
        },
        "sponsorship_id": {
          "type": "string",
          "format": "uuid"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          }
        },
        "policy_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "maximum_duration_months": {
          "const": 12
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "FULFILLED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "conditions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "description": "12-calendar-month maximum is enforced by CP at runtime; this record is NOT evidence that a requirement was satisfied or a waiver of law."
    }
  }
}
