{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v1/governance-readback.schema.json",
  "title": "CX-04C Organisation governance readback",
  "description": "Independently scoped, redacted, immutable-source legal mandate and provisioning readiness facts. UNKNOWN or STALE is never READY.",
  "$defs": {
    "MandateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandate_id",
        "tenant_id",
        "legal_entity_id",
        "status",
        "roles",
        "effective_from",
        "provenance",
        "evidence_count"
      ],
      "properties": {
        "mandate_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "legal_entity_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        },
        "provenance": {
          "type": "string"
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_reference_present": {
          "type": "boolean"
        }
      }
    },
    "ReadinessSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "state",
        "source",
        "evaluated_at",
        "overall_ready",
        "desired_state_version",
        "observed_state_version",
        "blocking_reasons"
      ],
      "properties": {
        "tenant_id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "READY",
            "BLOCKED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "IMMUTABLE_PROVISIONING_SNAPSHOT",
            "NO_SNAPSHOT"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "overall_ready": {
          "type": "boolean"
        },
        "desired_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "observed_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_reasons": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TenantGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "mandates_visible",
        "readiness_visible",
        "mandates"
      ],
      "properties": {
        "tenant_id": {
          "type": "string"
        },
        "mandates_visible": {
          "type": "boolean"
        },
        "readiness_visible": {
          "type": "boolean"
        },
        "mandates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/MandateSummary"
          }
        },
        "readiness": {
          "$ref": "#/$defs/ReadinessSummary"
        }
      }
    },
    "OrganisationGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organisation_id",
        "evaluated_at",
        "tenants"
      ],
      "properties": {
        "organisation_id": {
          "type": "string",
          "format": "uuid"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "tenants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/TenantGovernance"
          }
        }
      }
    }
  }
}
