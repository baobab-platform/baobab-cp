{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v1/overview.schema.json",
  "title": "Governed Organisation 360 overview (read-only projection)",
  "description": "Bounded, provenance-preserving Control Plane read model. Canonical identity, legal incorporation, relationships, platform affiliation and commercial tenancy are separate authorities. No applicant claim is inferred to be verified and no legal-actor mandate or downstream capability permission is granted.",
  "$defs": {
    "LegalEntityOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_entity_id",
        "legal_name",
        "legal_status",
        "verification_state",
        "source_authority",
        "evidence_count"
      ],
      "properties": {
        "legal_entity_id": {
          "type": "string",
          "minLength": 3
        },
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction_of_incorporation": {
          "type": "string"
        },
        "legal_status": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "source_authority": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CorporateRelationshipOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_organisation_id",
        "target_organisation_id",
        "relationship_type",
        "verification_state",
        "status",
        "direct_or_derived",
        "source_authority",
        "effective_from"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_organisation_id": {
          "type": "string"
        },
        "target_organisation_id": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "status": {
          "type": "string"
        },
        "direct_or_derived": {
          "type": "string"
        },
        "source_authority": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CorporateGroupMembershipOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "corporate_group_id",
        "status",
        "derived_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "corporate_group_id": {
          "type": "string"
        },
        "group_role": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "derived_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PlatformRelationshipOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform_id",
        "relationship_type",
        "verification_state",
        "status",
        "source_authority",
        "effective_from"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "status": {
          "type": "string"
        },
        "source_authority": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OrganisationOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organisation_id",
        "evaluated_at",
        "profile",
        "legal_entities",
        "corporate_relationships",
        "corporate_group_memberships",
        "platform_relationships"
      ],
      "properties": {
        "organisation_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "profile": {
          "$ref": "domain.schema.json#/$defs/Organisation"
        },
        "legal_entities": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/LegalEntityOverview"
          }
        },
        "corporate_relationships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CorporateRelationshipOverview"
          }
        },
        "corporate_group_memberships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CorporateGroupMembershipOverview"
          }
        },
        "platform_relationships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/PlatformRelationshipOverview"
          }
        },
        "tenants": {
          "type": "array",
          "maxItems": 100,
          "description": "Optional caller-authorised exact tenant.view projections only. Never infer tenant rights from legal incorporation, parent ownership, or holding-company affiliation. Each child subsection indicates whether the separate permission was present.",
          "items": {
            "$ref": "#/$defs/TenantOverview"
          }
        }
      }
    },
    "MarketParticipationOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "registry_market_id",
        "currency_code"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "minLength": 2
        },
        "registry_market_id": {
          "type": "string"
        },
        "currency_code": {
          "type": "string"
        }
      }
    },
    "SubscriptionOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "product_id",
        "status",
        "source",
        "effective_from"
      ],
      "properties": {
        "subscription_id": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DigitalEstateOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "domain",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "TenantOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "display_name",
        "mapping_role",
        "mapping_provenance",
        "residency_region",
        "isolation_strategy",
        "desired_state",
        "observed_state",
        "markets_visible",
        "subscriptions_visible",
        "estates_visible",
        "market_participations",
        "subscriptions",
        "digital_estates"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/tenantId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "mapping_role": {
          "type": "string"
        },
        "mapping_provenance": {
          "type": "string"
        },
        "residency_region": {
          "type": "string"
        },
        "isolation_strategy": {
          "type": "string"
        },
        "desired_state": {
          "type": "string"
        },
        "observed_state": {
          "type": "string"
        },
        "markets_visible": {
          "type": "boolean"
        },
        "subscriptions_visible": {
          "type": "boolean"
        },
        "estates_visible": {
          "type": "boolean"
        },
        "market_participations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/MarketParticipationOverview"
          }
        },
        "subscriptions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/SubscriptionOverview"
          }
        },
        "digital_estates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DigitalEstateOverview"
          }
        }
      }
    },
    "OrganisationDirectoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organisation_id",
        "display_name",
        "status",
        "verification_state",
        "source_authority"
      ],
      "properties": {
        "organisation_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "source_authority": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        }
      }
    },
    "OrganisationDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "items"
      ],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/OrganisationDirectoryEntry"
          }
        }
      }
    },
    "OrganisationDirectoryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "page_size",
        "sort",
        "total_visible",
        "items"
      ],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "sort": {
          "type": "string",
          "enum": [
            "name-asc",
            "name-desc"
          ]
        },
        "total_visible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/OrganisationDirectoryEntry"
          }
        },
        "next_after": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        }
      }
    }
  }
}
