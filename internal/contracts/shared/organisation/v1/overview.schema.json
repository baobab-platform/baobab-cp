{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.baobab-platform.com/organisation/v1/overview.schema.json",
  "title": "Governed Organisation 360 overview (read-only projection)",
  "description": "Bounded, provenance-preserving Control Plane read model. Canonical identity, legal incorporation, relationships, platform affiliation and commercial tenancy are separate authorities. No applicant claim is inferred to be verified and no legal-actor mandate or downstream capability permission is granted.",
  "$defs": {
    "LegalEntityOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_entity_id",
        "legal_name",
        "legal_status",
        "verification_state",
        "source_authority",
        "evidence_count"
      ],
      "properties": {
        "legal_entity_id": {
          "type": "string",
          "minLength": 3
        },
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction_of_incorporation": {
          "type": "string"
        },
        "legal_status": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "source_authority": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CorporateRelationshipOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_organisation_id",
        "target_organisation_id",
        "relationship_type",
        "verification_state",
        "status",
        "direct_or_derived",
        "source_authority",
        "effective_from"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_organisation_id": {
          "type": "string"
        },
        "target_organisation_id": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "status": {
          "type": "string"
        },
        "direct_or_derived": {
          "type": "string"
        },
        "source_authority": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "CorporateGroupMembershipOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "corporate_group_id",
        "status",
        "derived_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "corporate_group_id": {
          "type": "string"
        },
        "group_role": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "derived_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PlatformRelationshipOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform_id",
        "relationship_type",
        "verification_state",
        "status",
        "source_authority",
        "effective_from"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "platform_id": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "verification_state": {
          "$ref": "domain.schema.json#/$defs/verificationState"
        },
        "status": {
          "type": "string"
        },
        "source_authority": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "OrganisationOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organisation_id",
        "evaluated_at",
        "profile",
        "legal_entities",
        "corporate_relationships",
        "corporate_group_memberships",
        "platform_relationships"
      ],
      "properties": {
        "organisation_id": {
          "$ref": "../../control-plane/v1/domain.schema.json#/$defs/canonicalEntityId"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "profile": {
          "$ref": "domain.schema.json#/$defs/Organisation"
        },
        "legal_entities": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/LegalEntityOverview"
          }
        },
        "corporate_relationships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CorporateRelationshipOverview"
          }
        },
        "corporate_group_memberships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CorporateGroupMembershipOverview"
          }
        },
        "platform_relationships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/PlatformRelationshipOverview"
          }
        }
      }
    }
  }
}
